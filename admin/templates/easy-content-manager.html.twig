{% extends 'partials/base.html.twig' %}

{% block titlebar %}
    <div class="button-bar">
        <a class="button" href="{{ base_url }}"><i class="fa fa-reply"></i> {{ "PLUGIN_ADMIN.BACK"|t }}</a>
    </div>
    <h1><i class="fa fa-fw fa-list"></i> Content Manager</h1>
{% endblock %}

{% block content %}
{% set slms_active = ecm_slms_active() %}
{% set ftp_sync_available = ecm_ftp_sync_available() %}
<div id="ecm-app"
     data-ajax-url="{{ current_url }}.json"
     data-nonce="{{ admin.getNonce() }}"
     data-slms-active="{{ slms_active ? '1' : '0' }}"
     data-ftp-sync-available="{{ ftp_sync_available ? '1' : '0' }}">

    <style>
        #ecm-app { padding: 0 2rem 3rem 2rem; }

        #ecm-app .ecm-filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
            padding: 0.6rem 0.8rem;
            background: #f7f7f7;
            border: 1px solid #e6e6e6;
            border-radius: 4px;
        }
        #ecm-app .ecm-filter-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            height: 2.4rem;
        }
        #ecm-app .ecm-filter-item label {
            font-weight: 600;
            color: #555;
            white-space: nowrap;
            margin: 0;
        }
        #ecm-app #ecm-search {
            height: 2.4rem;
            box-sizing: border-box;
            min-width: 16rem;
            padding: 0 0.6rem;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        #ecm-app select,
        #ecm-app .ecm-filters .button {
            height: 2.4rem;
            box-sizing: border-box;
        }
        #ecm-app select {
            margin: 0;
            padding: 0 0.6rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            background: #fff;
            cursor: pointer;
            /* Without an explicit line-height matching the fixed height,
               some browsers (Chrome/Edge on Windows) anchor the select's
               text/arrow to the top of the box instead of centering it. */
            line-height: 2.4rem;
        }
        #ecm-app .ecm-filters .button {
            line-height: 1;
        }

        #ecm-app .ecm-filters + .ecm-filters { margin-top: -0.4rem; }
        #ecm-app .ecm-filter-item-search { flex: 1 1 auto; }
        #ecm-app .ecm-filter-item-search input { flex: 1 1 auto; }

        #ecm-app #ecm-status:not(:empty) { margin-bottom: 1rem; }

        /*
         * The admin theme renders <table class="overview-list"> with flexbox
         * (tr { display:flex }, td/th { display:block; flex:1 }) — CSS
         * `width` on td/th has no effect. Use `flex: 0 0 <rem>` (fixed) for
         * narrow columns, so Title keeps the default flex:1 and stretches.
         */
        #ecm-app table.overview-list td.ecm-col-narrow,
        #ecm-app table.overview-list th.ecm-col-narrow {
            flex: 0 0 8rem;
        }
        #ecm-app table.overview-list td.ecm-col-check,
        #ecm-app table.overview-list th.ecm-col-check {
            flex: 0 0 2.5rem;
            text-align: center;
        }
        #ecm-app table.overview-list td.ecm-col-check {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #ecm-app table.overview-list td.ecm-col-action,
        #ecm-app table.overview-list th.ecm-col-action {
            flex: 0 0 4.5rem;
            text-align: center;
        }
        #ecm-app table.overview-list td.ecm-col-action {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #ecm-app .ecm-bulk-bar { margin-top: 1rem; }
        #ecm-app .ecm-bulk-bar #ecm-selected-count {
            color: #555;
            font-weight: 600;
        }
        #ecm-app table.overview-list td,
        #ecm-app table.overview-list th {
            word-break: break-word;
            padding-top: 0.35rem;
            padding-bottom: 0.35rem;
        }
        #ecm-app table.overview-list tbody tr:nth-child(even) {
            background: #f5f5f5;
        }
        #ecm-app .ecm-slug {
            color: #777;
            font-size: 0.85rem;
        }
        #ecm-app .ecm-translation-ok { color: #2c5; font-weight: 600; }
        #ecm-app .ecm-translation-missing { color: #c9544a; font-weight: 600; }
        #ecm-app .ecm-empty {
            padding: 1rem 0;
            color: #777;
        }

        #ecm-app table.overview-list th.ecm-sortable {
            cursor: pointer;
            user-select: none;
            white-space: nowrap;
        }
        #ecm-app table.overview-list th.ecm-sortable:hover {
            color: #000;
        }
        #ecm-app table.overview-list th.ecm-sortable .ecm-sort-arrow {
            margin-left: 0.25rem;
            color: #999;
        }
        #ecm-app table.overview-list th.ecm-sortable.ecm-sort-active .ecm-sort-arrow {
            color: inherit;
        }

        #ecm-app .ecm-pagination {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-top: 1rem;
            padding: 0.6rem 0.8rem;
            background: #f7f7f7;
            border: 1px solid #e6e6e6;
            border-radius: 4px;
        }
        #ecm-app .ecm-pagination-nav {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        #ecm-app .ecm-pagination-nav .button {
            height: 2.4rem;
            box-sizing: border-box;
            line-height: 1;
        }
        #ecm-app #ecm-page-label {
            color: #555;
            font-weight: 600;
            white-space: nowrap;
        }

        #ecm-ftpsync-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        #ecm-ftpsync-modal-overlay.ecm-open { display: flex; }
        #ecm-ftpsync-modal {
            background: #fff;
            border-radius: 6px;
            width: min(760px, 92vw);
            max-height: 86vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 40px rgba(0,0,0,0.25);
        }
        #ecm-ftpsync-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.2rem;
            border-bottom: 1px solid #e6e6e6;
        }
        #ecm-ftpsync-modal-header h3 { margin: 0; font-size: 1.1rem; }
        #ecm-ftpsync-modal-close {
            background: none;
            border: none;
            font-size: 1.4rem;
            line-height: 1;
            cursor: pointer;
            color: #777;
        }
        #ecm-ftpsync-modal-body {
            padding: 1rem 1.2rem;
            overflow-y: auto;
        }
        #ecm-ftpsync-modal-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.75rem;
            padding: 1rem 1.2rem;
            border-top: 1px solid #e6e6e6;
        }
        #ecm-ftpsync-modal-status { margin-right: auto; color: #555; }
        #ecm-ftpsync-modal-status .ecm-ftpsync-error-detail { color: #b00020; }
        .ecm-ftpsync-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        .ecm-ftpsync-table th, .ecm-ftpsync-table td {
            text-align: left;
            padding: 0.4rem 0.5rem;
            border-bottom: 1px solid #eee;
            vertical-align: top;
        }
        .ecm-ftpsync-path { word-break: break-all; }
        .ecm-ftpsync-status-local-only { color: #1f6fb2; }
        .ecm-ftpsync-status-host-only { color: #b26a1f; }
        .ecm-ftpsync-status-newer { color: #1f6fb2; font-weight: 600; }
        .ecm-ftpsync-status-unknown { color: #777; }
        .ecm-ftpsync-resolution { width: 100%; border: 1px solid #ccc; border-radius: 4px; padding: 0.25rem 0.4rem; }
        .ecm-ftpsync-empty { color: #777; padding: 1rem 0; }
    </style>

    {# Khối 1: lọc theo Content type + Language — áp dụng trước, thu hẹp tập content. #}
    <div class="ecm-filters">
        <div class="ecm-filter-item">
            <label for="ecm-type">Content type</label>
            <select id="ecm-type">
                <option value="">All content</option>
                {% for slug, label in ecm_template_options() %}
                    <option value="{{ slug }}">{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        {% if slms_active %}
        <div class="ecm-filter-item">
            <label for="ecm-language">Language</label>
            <select id="ecm-language">
                <option value="">All languages</option>
                {% for code, label in ecm_language_options() %}
                    <option value="{{ code }}">{{ label }}</option>
                {% endfor %}
            </select>
        </div>
        {% endif %}
        <div class="ecm-filter-item">
            <label for="ecm-private-only"><input type="checkbox" id="ecm-private-only"> Private only</label>
        </div>
        <button type="button" class="button primary" id="ecm-filter-btn">
            <i class="fa fa-filter"></i> Filter
        </button>
    </div>

    {# Khối 2: search theo tiêu đề — bộ lọc độc lập, áp dụng SAU khối 1 ở trên (chạy trên tập content đã được lọc theo Content type + Language). Để trống = không lọc theo tiêu đề. #}
    <div class="ecm-filters">
        <div class="ecm-filter-item ecm-filter-item-search">
            <label for="ecm-search">Search theo tiêu đề</label>
            <input type="text" id="ecm-search">
        </div>
        <button type="button" class="button primary" id="ecm-search-btn">
            <i class="fa fa-search"></i> Search
        </button>
    </div>

    <div id="ecm-status"></div>

    {# Khối 3: chọn nhiều dòng + áp dụng hành động hàng loạt (xoá / đặt private) lên các dòng đã chọn. #}
    <div class="ecm-filters ecm-bulk-bar">
        <div class="ecm-filter-item">
            <button type="button" class="button" id="ecm-select-translations">Chọn các bản dịch</button>
        </div>
        <div class="ecm-filter-item">
            <label for="ecm-bulk-action">Áp dụng cho đã chọn</label>
            <select id="ecm-bulk-action">
                <option value="">-- Chọn hành động --</option>
                <option value="delete">Xoá</option>
                <option value="private">Đánh dấu Private</option>
            </select>
        </div>
        <button type="button" class="button primary" id="ecm-apply-btn">Áp dụng</button>
        <span id="ecm-selected-count"></span>
    </div>

    <table id="ecm-table" class="overview-list">
        <thead>
            <tr>
                <th class="ecm-col-check"><input type="checkbox" id="ecm-select-all"></th>
                <th class="ecm-col-narrow">Type</th>
                {% if slms_active %}
                <th class="ecm-col-narrow">Language</th>
                <th>Translation</th>
                {% endif %}
                <th>Title</th>
                <th class="ecm-col-narrow ecm-sortable" data-sort-field="date_ts">Ngày đăng<span class="ecm-sort-arrow"></span></th>
                <th class="ecm-col-narrow ecm-sortable" data-sort-field="modified_ts">Ngày sửa<span class="ecm-sort-arrow"></span></th>
                <th>Slug</th>
                {% if ftp_sync_available %}
                <th class="ecm-col-action">FTP Sync</th>
                {% endif %}
                <th class="ecm-col-action">Edit</th>
                <th class="ecm-col-action">Delete</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <div class="ecm-pagination">
        <div class="ecm-filter-item">
            <label for="ecm-page-size">Số dòng/trang</label>
            <select id="ecm-page-size">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="ecm-pagination-nav">
            <button type="button" class="button" id="ecm-prev-page" title="Trang trước"><i class="fa fa-chevron-left"></i></button>
            <span id="ecm-page-label">Trang 1 / 1</span>
            <button type="button" class="button" id="ecm-next-page" title="Trang sau"><i class="fa fa-chevron-right"></i></button>
        </div>
    </div>

    {% if ftp_sync_available %}
    <div id="ecm-ftpsync-modal-overlay">
        <div id="ecm-ftpsync-modal">
            <div id="ecm-ftpsync-modal-header">
                <h3>FTP Sync — <span id="ecm-ftpsync-modal-title"></span></h3>
                <button type="button" id="ecm-ftpsync-modal-close">&times;</button>
            </div>
            <div id="ecm-ftpsync-modal-body"></div>
            <div id="ecm-ftpsync-modal-footer">
                <span id="ecm-ftpsync-modal-status"></span>
                <button type="button" class="button" id="ecm-ftpsync-modal-cancel">Đóng</button>
                <button type="button" class="button primary" id="ecm-ftpsync-modal-apply">Áp dụng</button>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script>
(function () {
    var app = document.getElementById('ecm-app');
    if (!app) { return; }

    var ajaxUrl = app.dataset.ajaxUrl;
    var nonce = app.dataset.nonce;
    var slmsActive = app.dataset.slmsActive === '1';
    var ftpSyncAvailable = app.dataset.ftpSyncAvailable === '1';

    var searchInput = document.getElementById('ecm-search');
    var typeSelect = document.getElementById('ecm-type');
    var languageSelect = document.getElementById('ecm-language');
    var privateOnlyCheckbox = document.getElementById('ecm-private-only');
    var filterBtn = document.getElementById('ecm-filter-btn');
    var searchBtn = document.getElementById('ecm-search-btn');
    var statusEl = document.getElementById('ecm-status');
    var table = document.getElementById('ecm-table');
    var tbody = table.querySelector('tbody');
    var pageSizeSelect = document.getElementById('ecm-page-size');
    var prevPageBtn = document.getElementById('ecm-prev-page');
    var nextPageBtn = document.getElementById('ecm-next-page');
    var pageLabel = document.getElementById('ecm-page-label');
    var selectAllCheckbox = document.getElementById('ecm-select-all');
    var selectTranslationsBtn = document.getElementById('ecm-select-translations');
    var bulkActionSelect = document.getElementById('ecm-bulk-action');
    var applyBtn = document.getElementById('ecm-apply-btn');
    var selectedCountEl = document.getElementById('ecm-selected-count');
    var sortHeaders = table.querySelectorAll('th.ecm-sortable');

    var allRows = [];
    var currentPage = 1;
    var selectedRoutes = new Set();
    var sortField = 'date_ts';
    var sortDir = 'desc';

    function applySort() {
        if (!sortField) { return; }
        var dir = sortDir === 'asc' ? 1 : -1;
        allRows.sort(function (a, b) {
            var av = a[sortField] || 0;
            var bv = b[sortField] || 0;
            if (av === bv) { return 0; }
            return av < bv ? -dir : dir;
        });
    }

    function updateSortHeaders() {
        sortHeaders.forEach(function (th) {
            var isActive = th.dataset.sortField === sortField;
            th.classList.toggle('ecm-sort-active', isActive);
            var arrow = th.querySelector('.ecm-sort-arrow');
            arrow.textContent = isActive ? (sortDir === 'asc' ? '▲' : '▼') : '';
        });
    }

    function currentPageRows() {
        var start = (currentPage - 1) * pageSize();
        return allRows.slice(start, start + pageSize());
    }

    function updateSelectAllState(pageRows) {
        if (!pageRows || pageRows.length === 0) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
            return;
        }
        var selectedCount = pageRows.filter(function (r) { return selectedRoutes.has(r.route); }).length;
        selectAllCheckbox.checked = selectedCount === pageRows.length;
        selectAllCheckbox.indeterminate = selectedCount > 0 && selectedCount < pageRows.length;
    }

    function updateSelectedCount() {
        selectedCountEl.textContent = selectedRoutes.size > 0 ? selectedRoutes.size + ' đã chọn' : '';
    }

    function setStatus(message, isError) {
        statusEl.textContent = message || '';
        statusEl.className = isError ? 'notices error' : 'notices';
    }

    function post(task, fields) {
        var fd = new FormData();
        fd.append('task', task);
        fd.append('admin-nonce', nonce);
        Object.keys(fields || {}).forEach(function (key) {
            fd.append(key, fields[key]);
        });

        return fetch(ajaxUrl, { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function (res) { return res.json(); });
    }

    function renderRows(rows) {
        tbody.innerHTML = '';

        if (!rows || rows.length === 0) {
            var tr = document.createElement('tr');
            var td = document.createElement('td');
            td.className = 'ecm-empty';
            td.colSpan = (slmsActive ? 8 : 6) + 2 + (ftpSyncAvailable ? 1 : 0);
            td.textContent = 'Không có content nào khớp bộ lọc.';
            tr.appendChild(td);
            tbody.appendChild(tr);
            return;
        }

        rows.forEach(function (row) {
            var tr = document.createElement('tr');

            var tdCheck = document.createElement('td');
            tdCheck.className = 'ecm-col-check';
            var checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.className = 'ecm-row-check';
            checkbox.dataset.route = row.route;
            checkbox.checked = selectedRoutes.has(row.route);
            tdCheck.appendChild(checkbox);
            tr.appendChild(tdCheck);

            var tdType = document.createElement('td');
            tdType.className = 'ecm-col-narrow';
            tdType.textContent = row.type_label;
            tr.appendChild(tdType);

            if (slmsActive) {
                var tdLang = document.createElement('td');
                tdLang.className = 'ecm-col-narrow';
                tdLang.textContent = row.language_label || '';
                tr.appendChild(tdLang);

                var tdTrans = document.createElement('td');
                var isOk = row.translation === 'OK';
                tdTrans.className = isOk ? 'ecm-translation-ok' : 'ecm-translation-missing';
                tdTrans.textContent = row.translation || '';
                tr.appendChild(tdTrans);
            }

            var tdTitle = document.createElement('td');
            tdTitle.textContent = row.title;
            tr.appendChild(tdTitle);

            var tdDate = document.createElement('td');
            tdDate.className = 'ecm-col-narrow';
            tdDate.textContent = row.date || '';
            tr.appendChild(tdDate);

            var tdModified = document.createElement('td');
            tdModified.className = 'ecm-col-narrow';
            tdModified.textContent = row.modified || '';
            tr.appendChild(tdModified);

            var tdSlug = document.createElement('td');
            tdSlug.className = 'ecm-slug';
            tdSlug.textContent = row.slug;
            tr.appendChild(tdSlug);

            if (ftpSyncAvailable) {
                var tdFtpSync = document.createElement('td');
                tdFtpSync.className = 'ecm-col-action';
                var ftpSyncBtn = document.createElement('button');
                ftpSyncBtn.type = 'button';
                ftpSyncBtn.className = 'button';
                ftpSyncBtn.title = 'Check FTP Sync';
                ftpSyncBtn.innerHTML = '<i class="fa fa-exchange"></i>';
                ftpSyncBtn.dataset.ftpsyncRoute = row.route;
                ftpSyncBtn.dataset.ftpsyncTitle = row.title;
                tdFtpSync.appendChild(ftpSyncBtn);
                tr.appendChild(tdFtpSync);
            }

            var tdEdit = document.createElement('td');
            tdEdit.className = 'ecm-col-action';
            var editLink = document.createElement('a');
            editLink.className = 'button';
            editLink.href = row.edit_url;
            editLink.title = 'Edit';
            editLink.innerHTML = '<i class="fa fa-pencil"></i>';
            tdEdit.appendChild(editLink);
            tr.appendChild(tdEdit);

            var tdDelete = document.createElement('td');
            tdDelete.className = 'ecm-col-action';
            var deleteBtn = document.createElement('button');
            deleteBtn.type = 'button';
            deleteBtn.className = 'button';
            deleteBtn.title = 'Delete';
            deleteBtn.innerHTML = '<i class="fa fa-trash"></i>';
            deleteBtn.dataset.route = row.route;
            deleteBtn.dataset.title = row.title;
            tdDelete.appendChild(deleteBtn);
            tr.appendChild(tdDelete);

            tbody.appendChild(tr);
        });
    }

    var FILTERS_STORAGE_KEY = 'ecm-filters';

    function saveFilters() {
        try {
            var saved = {
                type: typeSelect.value,
                q: searchInput.value,
                pageSize: pageSizeSelect.value,
                privateOnly: privateOnlyCheckbox.checked
            };
            if (slmsActive && languageSelect) {
                saved.language = languageSelect.value;
            }
            localStorage.setItem(FILTERS_STORAGE_KEY, JSON.stringify(saved));
        } catch (e) { /* private browsing / storage blocked — ignore */ }
    }

    function restoreFilters() {
        try {
            var raw = localStorage.getItem(FILTERS_STORAGE_KEY);
            if (!raw) { return; }
            var saved = JSON.parse(raw);
            if (saved.type !== undefined) { typeSelect.value = saved.type; }
            if (saved.q !== undefined) { searchInput.value = saved.q; }
            if (saved.pageSize !== undefined) { pageSizeSelect.value = saved.pageSize; }
            if (saved.privateOnly !== undefined) { privateOnlyCheckbox.checked = saved.privateOnly; }
            if (slmsActive && languageSelect && saved.language !== undefined) {
                languageSelect.value = saved.language;
            }
        } catch (e) { /* private browsing / storage blocked / bad JSON — ignore */ }
    }

    function pageSize() {
        return parseInt(pageSizeSelect.value, 10) || 20;
    }

    function totalPages() {
        return Math.max(1, Math.ceil(allRows.length / pageSize()));
    }

    function renderPage() {
        var pages = totalPages();
        if (currentPage > pages) { currentPage = pages; }
        if (currentPage < 1) { currentPage = 1; }

        var pageRows = currentPageRows();
        renderRows(pageRows);
        updateSelectAllState(pageRows);
        updateSelectedCount();

        pageLabel.textContent = 'Trang ' + currentPage + ' / ' + pages;
        prevPageBtn.disabled = currentPage <= 1;
        nextPageBtn.disabled = currentPage >= pages;
    }

    function loadContent() {
        setStatus('Đang tải...', false);
        saveFilters();

        var fields = {
            type: typeSelect.value,
            q: searchInput.value,
            private_only: privateOnlyCheckbox.checked ? '1' : ''
        };
        if (slmsActive && languageSelect) {
            fields.language = languageSelect.value;
        }

        post('ecmlistcontent', fields).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                return;
            }
            allRows = data.rows || [];
            currentPage = 1;
            selectedRoutes.clear();
            applySort();
            updateSortHeaders();
            renderPage();
            setStatus(allRows.length + ' content.', false);
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
        });
    }

    filterBtn.addEventListener('click', loadContent);
    searchBtn.addEventListener('click', loadContent);

    pageSizeSelect.addEventListener('change', function () {
        saveFilters();
        currentPage = 1;
        renderPage();
    });
    prevPageBtn.addEventListener('click', function () {
        currentPage--;
        renderPage();
    });
    nextPageBtn.addEventListener('click', function () {
        currentPage++;
        renderPage();
    });
    searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            loadContent();
        }
    });

    tbody.addEventListener('click', function (e) {
        var btn = e.target.closest('button[data-route]');
        if (!btn) { return; }

        var route = btn.dataset.route;
        var title = btn.dataset.title;
        if (!window.confirm('Xóa content "' + title + '"? Thao tác này không thể hoàn tác.')) {
            return;
        }

        setStatus('Đang xóa...', false);
        post('ecmdeletecontent', { route: route }).then(function (data) {
            if (data.status !== 'success') {
                setStatus('Error: ' + (data.message || 'unknown'), true);
                return;
            }
            setStatus('Đã xóa.', false);
            loadContent();
        }).catch(function (e) {
            setStatus('Error: ' + e, true);
        });
    });

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = String(str === undefined || str === null ? '' : str);
        return div.innerHTML;
    }

    if (ftpSyncAvailable) {
        var ftpSyncOverlay = document.getElementById('ecm-ftpsync-modal-overlay');
        var ftpSyncTitleEl = document.getElementById('ecm-ftpsync-modal-title');
        var ftpSyncBodyEl = document.getElementById('ecm-ftpsync-modal-body');
        var ftpSyncStatusEl = document.getElementById('ecm-ftpsync-modal-status');
        var ftpSyncApplyBtn = document.getElementById('ecm-ftpsync-modal-apply');
        var ftpSyncCloseBtn = document.getElementById('ecm-ftpsync-modal-close');
        var ftpSyncCancelBtn = document.getElementById('ecm-ftpsync-modal-cancel');
        var ftpSyncCurrentRoute = null;

        var FTPSYNC_TYPE_LABELS = {
            missing_remote: 'Chỉ có ở Local (chưa có trên Hosting)',
            missing_local: 'Chỉ có ở Hosting (chưa có ở Local)'
        };

        var FTPSYNC_RESOLUTION_OPTIONS = [
            ['', '-- Bỏ qua --'],
            ['local', 'Đẩy lên Hosting (Local → Remote)'],
            ['remote', 'Kéo về Local (Remote → Local)'],
            ['delete_local', 'Xoá ở Local'],
            ['delete_remote', 'Xoá ở Hosting']
        ];

        // Gợi ý mặc định giống hệt logic UI của chính plugin ftp-sync (xem
        // admin-next/pages/ftp-sync.js): bên nào mới hơn thì mặc định đẩy/kéo
        // theo hướng đó; chỉ có ở 1 bên thì mặc định đẩy/kéo cho khớp.
        function ftpSyncDefaultResolution(row) {
            if (row.type === 'changed') {
                if (row.newer === 'local') { return 'local'; }
                if (row.newer === 'remote') { return 'remote'; }
                return '';
            }
            if (row.type === 'missing_remote') { return 'local'; }
            if (row.type === 'missing_local') { return 'remote'; }
            return '';
        }

        function ftpSyncStatusLabel(row) {
            if (row.type === 'changed') {
                if (row.newer === 'local') { return 'Khác nhau — Local mới hơn'; }
                if (row.newer === 'remote') { return 'Khác nhau — Hosting mới hơn'; }
                return 'Khác nhau — không rõ bên nào mới hơn';
            }
            return FTPSYNC_TYPE_LABELS[row.type] || row.type;
        }

        function ftpSyncStatusClass(row) {
            if (row.type === 'missing_remote') { return 'ecm-ftpsync-status-local-only'; }
            if (row.type === 'missing_local') { return 'ecm-ftpsync-status-host-only'; }
            if (row.type === 'changed' && row.newer) { return 'ecm-ftpsync-status-newer'; }
            return 'ecm-ftpsync-status-unknown';
        }

        function ftpSyncFormatStat(stat) {
            if (!stat) { return '—'; }
            var d = new Date(stat.mtime * 1000);
            return stat.size + ' bytes, ' + d.toLocaleString();
        }

        function ftpSyncCloseModal() {
            ftpSyncOverlay.classList.remove('ecm-open');
            ftpSyncCurrentRoute = null;
        }

        function ftpSyncRenderRows(rows) {
            var paths = Object.keys(rows);
            if (paths.length === 0) {
                ftpSyncBodyEl.innerHTML = '<div class="ecm-ftpsync-empty">Không có khác biệt nào — Local và Hosting đã khớp.</div>';
                ftpSyncApplyBtn.disabled = true;
                return;
            }

            ftpSyncApplyBtn.disabled = false;

            var html = '<table class="ecm-ftpsync-table"><thead><tr>'
                + '<th>File</th><th>Trạng thái</th><th>Local</th><th>Hosting</th><th>Xử lý</th>'
                + '</tr></thead><tbody>';

            paths.forEach(function (path) {
                var row = rows[path];
                var def = ftpSyncDefaultResolution(row);
                var rowOptions = FTPSYNC_RESOLUTION_OPTIONS.map(function (opt) {
                    var selected = opt[0] === def ? ' selected' : '';
                    return '<option value="' + opt[0] + '"' + selected + '>' + opt[1] + '</option>';
                }).join('');

                html += '<tr>'
                    + '<td class="ecm-ftpsync-path">' + escapeHtml(path) + '</td>'
                    + '<td class="' + ftpSyncStatusClass(row) + '">' + escapeHtml(ftpSyncStatusLabel(row)) + '</td>'
                    + '<td>' + escapeHtml(ftpSyncFormatStat(row.local)) + '</td>'
                    + '<td>' + escapeHtml(ftpSyncFormatStat(row.remote)) + '</td>'
                    + '<td><select class="ecm-ftpsync-resolution" data-path="' + escapeHtml(path) + '">' + rowOptions + '</select></td>'
                    + '</tr>';
            });

            html += '</tbody></table>';
            ftpSyncBodyEl.innerHTML = html;
        }

        function ftpSyncOpenModal(route, title, preserveStatus) {
            ftpSyncCurrentRoute = route;
            ftpSyncTitleEl.textContent = title;
            if (!preserveStatus) { ftpSyncStatusEl.textContent = ''; }
            ftpSyncBodyEl.innerHTML = '<div class="ecm-ftpsync-empty">Đang kiểm tra...</div>';
            ftpSyncApplyBtn.disabled = true;
            ftpSyncOverlay.classList.add('ecm-open');

            post('ecmftpsynccheck', { route: route }).then(function (data) {
                if (ftpSyncCurrentRoute !== route) { return; }
                if (data.status !== 'success') {
                    ftpSyncBodyEl.innerHTML = '<div class="ecm-ftpsync-empty">Error: ' + escapeHtml(data.message || 'unknown') + '</div>';
                    return;
                }
                ftpSyncRenderRows(data.rows || {});
            }).catch(function (e) {
                if (ftpSyncCurrentRoute !== route) { return; }
                ftpSyncBodyEl.innerHTML = '<div class="ecm-ftpsync-empty">Error: ' + escapeHtml(String(e)) + '</div>';
            });
        }

        tbody.addEventListener('click', function (e) {
            var btn = e.target.closest('button[data-ftpsync-route]');
            if (!btn) { return; }
            ftpSyncOpenModal(btn.dataset.ftpsyncRoute, btn.dataset.ftpsyncTitle);
        });

        ftpSyncCloseBtn.addEventListener('click', ftpSyncCloseModal);
        ftpSyncCancelBtn.addEventListener('click', ftpSyncCloseModal);
        ftpSyncOverlay.addEventListener('click', function (e) {
            if (e.target === ftpSyncOverlay) { ftpSyncCloseModal(); }
        });

        ftpSyncApplyBtn.addEventListener('click', function () {
            if (!ftpSyncCurrentRoute) { return; }

            var resolutions = {};
            ftpSyncBodyEl.querySelectorAll('.ecm-ftpsync-resolution').forEach(function (select) {
                if (select.value) { resolutions[select.dataset.path] = select.value; }
            });

            if (Object.keys(resolutions).length === 0) {
                window.alert('Chưa chọn cách xử lý cho file nào.');
                return;
            }

            ftpSyncApplyBtn.disabled = true;
            ftpSyncStatusEl.textContent = 'Đang áp dụng...';

            post('ecmftpsyncapply', { route: ftpSyncCurrentRoute, resolutions: JSON.stringify(resolutions) }).then(function (data) {
                if (data.status !== 'success') {
                    ftpSyncStatusEl.textContent = 'Error: ' + (data.message || 'unknown');
                    ftpSyncApplyBtn.disabled = false;
                    return;
                }

                var msg = 'Đã áp dụng ' + data.applied + ' file.';
                if (data.skipped) { msg += ' Bỏ qua/lỗi: ' + data.skipped + '.'; }
                if (data.backup) { msg += ' Backup: ' + data.backup + '.'; }

                var errors = data.errors || {};
                var errorPaths = Object.keys(errors);
                if (errorPaths.length > 0) {
                    var detail = errorPaths.map(function (p) {
                        return escapeHtml(p) + ': ' + escapeHtml(errors[p]);
                    }).join('<br>');
                    ftpSyncStatusEl.innerHTML = escapeHtml(msg) + '<br><span class="ecm-ftpsync-error-detail">' + detail + '</span>';
                } else {
                    ftpSyncStatusEl.textContent = msg;
                }
                ftpSyncApplyBtn.disabled = false;

                var route = ftpSyncCurrentRoute;
                var title = ftpSyncTitleEl.textContent;
                ftpSyncOpenModal(route, title, true);
                loadContent();
            }).catch(function (e) {
                ftpSyncStatusEl.textContent = 'Error: ' + e;
                ftpSyncApplyBtn.disabled = false;
            });
        });
    }

    tbody.addEventListener('change', function (e) {
        var cb = e.target.closest('input.ecm-row-check');
        if (!cb) { return; }

        if (cb.checked) {
            selectedRoutes.add(cb.dataset.route);
        } else {
            selectedRoutes.delete(cb.dataset.route);
        }
        updateSelectAllState(currentPageRows());
        updateSelectedCount();
    });

    sortHeaders.forEach(function (th) {
        th.addEventListener('click', function () {
            var field = th.dataset.sortField;
            if (sortField === field) {
                sortDir = sortDir === 'asc' ? 'desc' : 'asc';
            } else {
                sortField = field;
                sortDir = 'desc';
            }
            applySort();
            updateSortHeaders();
            currentPage = 1;
            renderPage();
        });
    });

    selectAllCheckbox.addEventListener('change', function () {
        var pageRows = currentPageRows();
        pageRows.forEach(function (r) {
            if (selectAllCheckbox.checked) {
                selectedRoutes.add(r.route);
            } else {
                selectedRoutes.delete(r.route);
            }
        });
        renderPage();
    });

    // "Chọn các bản dịch": với mỗi dòng đang được chọn, tự chọn thêm các bản
    // dịch của nó — nhưng chỉ những bản dịch đang hiển thị trong tập đã lọc
    // hiện tại (allRows). Nếu bộ lọc Language đang thu hẹp danh sách chỉ còn
    // 1 ngôn ngữ thì bản dịch (ngôn ngữ khác) sẽ không có trong allRows và
    // không thể tự chọn được — bỏ filter Language để dùng tính năng này.
    selectTranslationsBtn.addEventListener('click', function () {
        var routeIndex = {};
        allRows.forEach(function (r) { routeIndex[r.route] = true; });

        Array.from(selectedRoutes).forEach(function (route) {
            var row = allRows.filter(function (r) { return r.route === route; })[0];
            if (!row || !row.translations) { return; }
            Object.keys(row.translations).forEach(function (lang) {
                var targetRoute = row.translations[lang];
                if (routeIndex[targetRoute]) {
                    selectedRoutes.add(targetRoute);
                }
            });
        });

        renderPage();
    });

    applyBtn.addEventListener('click', function () {
        var action = bulkActionSelect.value;
        if (!action) {
            window.alert('Hãy chọn 1 hành động.');
            return;
        }

        var routes = Array.from(selectedRoutes);
        if (routes.length === 0) {
            window.alert('Chưa chọn bài viết nào.');
            return;
        }

        var actionLabel = action === 'delete' ? 'XOÁ' : 'ĐÁNH DẤU PRIVATE';
        if (!window.confirm(actionLabel + ' ' + routes.length + ' bài viết đã chọn? Thao tác xoá không thể hoàn tác.')) {
            return;
        }

        var task = action === 'delete' ? 'ecmdeletecontent' : 'ecmsetprivate';
        applyBtn.disabled = true;
        setStatus('Đang xử lý ' + routes.length + ' bài viết...', false);

        var done = 0;
        var failed = [];

        function next() {
            if (done >= routes.length) {
                applyBtn.disabled = false;
                if (failed.length > 0) {
                    setStatus('Hoàn tất với ' + failed.length + ' lỗi: ' + failed.join(', '), true);
                } else {
                    setStatus('Đã áp dụng cho ' + routes.length + ' bài viết.', false);
                }
                loadContent();
                return;
            }

            var route = routes[done];
            post(task, { route: route }).then(function (data) {
                if (data.status !== 'success') {
                    failed.push(route + ' (' + (data.message || 'lỗi') + ')');
                }
            }).catch(function (e) {
                failed.push(route + ' (' + e + ')');
            }).then(function () {
                done++;
                next();
            });
        }

        next();
    });

    restoreFilters();
    loadContent();
})();
</script>
{% endblock %}
